# Conversa SaaS Environment Variables

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Public & Service Role
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Encryption Secret (32 bytes hex or key for AES-256-GCM token encryption)
TOKEN_ENCRYPTION_SECRET=your-32-byte-secret-hex-string-for-page-tokens

# Google Gemini AI API Key
GEMINI_API_KEY=your-gemini-api-key

# Meta Developer App (Facebook Messenger)
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_WEBHOOK_VERIFY_TOKEN=your-random-webhook-verify-token
